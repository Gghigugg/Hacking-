<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#8B5CFF" />
            <stroke android:width="3dp" android:color="#D9CCFF" />
            <padding android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:angle="45" android:startColor="#8B5CFF" android:centerColor="#5C2BFF" android:endColor="#B86BFF" />
            <stroke android:width="3dp" android:color="#FFFFFF" android:alpha="0.55" />
            <padding android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp" />
        </shape>
    </item>
</selector>
